{
  "name": "email-host-convex",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo build",
    "check:frontend-architecture": "bun run scripts/check-frontend-architecture.ts",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "migrate:owner:apply": "bun run scripts/migrate-owner-to-convex.ts --apply",
    "migrate:owner:dry-run": "bun run scripts/migrate-owner-to-convex.ts",
    "migrate:user:apply": "bun run scripts/migrate-user-to-convex.ts --apply",
    "migrate:user:dry-run": "bun run scripts/migrate-user-to-convex.ts",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.15.6",
    "jose": "6.2.5",
    "pg": "^8.16.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "~6"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.4",
    "convex": "1.42.3"
  }
}
