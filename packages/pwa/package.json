{
  "name": "@workspace/pwa",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.server.json",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "react": "^19.2.6",
    "vite-plugin-pwa": "^1.3.0",
    "web-push": "^3.6.7",
    "workbox-precaching": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^10",
    "globals": "^17",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "exports": {
    "./client": "./src/client.ts",
    "./react": "./src/react.ts",
    "./server": "./src/server.ts",
    "./service-worker": "./src/service-worker.ts",
    "./vite": "./src/vite.ts"
  }
}
