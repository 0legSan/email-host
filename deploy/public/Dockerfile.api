# syntax=docker/dockerfile:1.7
FROM oven/bun:1.3.5@sha256:e90cdbaf9ccdb3d4bd693aa335c3310a6004286a880f62f79b18f9b1312a8ec3
WORKDIR /app
LABEL org.opencontainers.image.source="https://github.com/0legSan/email-host"
LABEL org.opencontainers.image.licenses="MIT"

COPY docker/api/package.json docker/api/bun.lock ./
COPY apps/api/package.json apps/api/package.json
COPY packages/mail-agent/package.json packages/mail-agent/package.json
COPY packages/pwa/package.json packages/pwa/package.json
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile --production
COPY scripts/collect-third-party-licenses.mjs ./scripts/collect-third-party-licenses.mjs
RUN bun scripts/collect-third-party-licenses.mjs --root node_modules --output /usr/share/licenses/third-party

COPY apps/api ./apps/api
COPY tsconfig.json ./tsconfig.json
COPY convex ./convex
COPY packages/mail-agent ./packages/mail-agent
COPY packages/pwa ./packages/pwa
COPY deploy/public/bootstrap.mjs ./deploy/public/bootstrap.mjs
COPY LICENSE /usr/share/licenses/email-host/LICENSE

EXPOSE 3001
CMD ["bun", "apps/api/src/index.ts"]
