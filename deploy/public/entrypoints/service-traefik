#!/usr/bin/env bash
set -euo pipefail
umask 077

# Keep a single installer implementation behind the mode-specific entrypoints.
installer=$(mktemp /tmp/email-host-bootstrap.XXXXXXXX)
trap 'rm -f -- "$installer"' EXIT
curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
  --tlsv1.2 --connect-timeout 15 --max-time 120 --retry 2 --max-filesize 131072 \
  https://emailhost.olegsan.tech/install/installer.sh --output "$installer"
bash "$installer" --mode traefik "$@"
